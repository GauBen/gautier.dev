{
  "name": "gautier.dev",
  "private": true,
  "type": "module",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#lib/*": "./src/lib/*",
    "#search/*": "./src/search/*"
  },
  "workspaces": [
    "adapter"
  ],
  "scripts": {
    "build": "rolldown temporal-polyfill/global -mo static/build/temporal.js && node src/build-search-index.ts && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && stylelint --ignore-pattern .gitignore '**/*.{css,svelte}'",
    "dev": "vite dev",
    "format": "prettier --write --ignore-unknown '**/*'",
    "postinstall": "svelte-kit sync",
    "preview": "vite preview"
  },
  "dependencies": {
    "devalue": "^6.0.3",
    "giscus": "^1.6.0",
    "pele": "^1.13.0",
    "prism-svelte": "^0.5.0",
    "prismjs": "^1.30.0",
    "prismjs-gleam": "^1.0.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@iconify-svelte/ph": "^1.0.3",
    "@mdit/plugin-tex": "^1.3.0",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "adapter-node-sea": "workspace:*",
    "globals": "^17.14.0",
    "katex": "^0.19.1",
    "markdown-it-anchor": "^10.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "rolldown": "^1.3.1",
    "satori": "^0.63.2",
    "stylelint": "^18.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "temporal-polyfill": "^1.0.8",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "vite": "^8.3.7",
    "vite-plugin-svelte-md": "^0.8.1",
    "xast-util-to-xml": "^4.0.0",
    "xastscript": "^4.0.1"
  }
}

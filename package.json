{
  "name": "gautier.dev",
  "private": true,
  "type": "module",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#lib/*": "./src/lib/*",
    "#search/*": "./src/search/*"
  },
  "workspaces": [
    "adapter"
  ],
  "scripts": {
    "build": "rolldown temporal-polyfill/global -mo static/build/temporal.js && node src/build-search-index.ts && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && stylelint --ignore-pattern .gitignore '**/*.{css,svelte}'",
    "dev": "vite dev",
    "format": "prettier --write --ignore-unknown '**/*'",
    "postinstall": "svelte-kit sync",
    "preview": "vite preview"
  },
  "dependencies": {
    "beautiful-mermaid": "^1.1.3",
    "devalue": "^5.9.0",
    "giscus": "^1.6.0",
    "prism-svelte": "^0.5.0",
    "prismjs": "^1.30.0",
    "prismjs-gleam": "^1.0.4"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@iconify-svelte/ph": "^1.0.3",
    "@mdit/plugin-tex": "^1.0.2",
    "@sveltejs/enhanced-img": "^1.0.0-next.2",
    "@sveltejs/kit": "^3.0.0-next.13",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.2",
    "@types/prismjs": "^1.26.6",
    "adapter-node-sea": "workspace:*",
    "globals": "^17.8.0",
    "katex": "^0.18.1",
    "markdown-it-anchor": "^9.2.1",
    "modern-normalize": "^3.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-svelte": "^4.1.1",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "rolldown": "^1.2.1",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "temporal-polyfill": "^1.0.2",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "vite": "^8.2.0",
    "vite-plugin-svelte-md": "^0.8.0"
  },
  "aube": {
    "allowBuilds": {
      "sharp": true
    }
  }
}
